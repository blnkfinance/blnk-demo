APP_ENV=development

# External Blnk Cloud/Core connection. Do not commit real values.
BLNK_BASE_URL=https://your-blnk-instance.example.com
BLNK_API_KEY=replace-with-scoped-blnk-api-key
BLNK_WEBHOOK_SECRET=replace-with-webhook-secret

# Defaults are container-friendly and can be overridden for local development.
MONGO_DATABASE=pro_loan_app
REDIS_PASSWORD=

# HMAC secret used to sign session tokens. Generate with: openssl rand -hex 32
AUTH_SECRET=replace-with-random-hex-secret

# Public URLs (set these in Coolify to your generated domains; localhost is fine locally).
ADMIN_FRONTEND_URL=http://localhost:3100
CUSTOMER_FRONTEND_URL=http://localhost:3101
NEXT_PUBLIC_API_URL=http://localhost:8180
