# From the api container, localhost is the container itself — use Blnk Cloud URL or host.docker.internal.
BLNK_BASE_URL=https://your-workspace.blnkfinance.com
BLNK_API_KEY=replace-with-scoped-blnk-api-key

DATABASE_URL=postgres://payrecon:payrecon@postgres-main:5432/pay_recon?sslmode=disable
ORG_NAME=IBEDC-Operations
DEFAULT_CURRENCY=NGN

AUTH_SECRET=replace-with-random-hex-secret
APP_ENV=development
