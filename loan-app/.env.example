# loan-app environment reference
#
# Copy the backend block into `backend/.env` and the frontend block into
# `frontend/.env.local`. Do not commit real secrets or local overrides.

# =============================================================================
# backend/.env
# =============================================================================

# Public origin Omni Cloud reaches for /callback and POST /portal.
# In development, run `ngrok http 4721` and paste the HTTPS forwarding URL here.
BACKEND_PUBLIC_URL="http://localhost:4721"

# Frontend origin: embedded in portal_url and used as the CORS allowed origin.
# Defaults to BACKEND_PUBLIC_URL when unset.
PORTAL_BASE_URL="http://localhost:3001"

# HTTP port for the backend server.
PORT=4721

# Filesystem path to the SQLite database file. Created on first run.
SQLITE_DB_PATH="./data/app.db"

# 32-byte hex key used by AES-256-GCM to encrypt scoped API keys at rest.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY_HEX="replace-with-64-hex-chars-from-openssl-rand-hex-32"

# Omni Cloud API base URL. Must match the Cloud deployment that installed the app.
BLNK_CLOUD_API_ORIGIN="https://core.omnigroup.tech"

# development | production
NODE_ENV="development"

# Minimum log level: debug | info | warn | error
LOG_LEVEL="debug"

# Log output format: pretty | json
LOG_FORMAT="pretty"

# Optional extra frame-ancestors sources (space-separated) for non-standard Cloud origins.
# FRAME_ANCESTORS_EXTRA="https://your-tunnel.ngrok-free.app"

# =============================================================================
# frontend/.env.local
# =============================================================================

# Next.js dev/server port.
PORT=3001

# Backend origin for browser API calls.
NEXT_PUBLIC_BACKEND_PUBLIC_URL=http://localhost:4721

# Optional extra frame-ancestors sources (space-separated) for non-standard Cloud origins.
# FRAME_ANCESTORS_EXTRA="https://your-tunnel.ngrok-free.app"
