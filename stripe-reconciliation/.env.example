# Blnk API Configuration
BLNK_API_KEY=your_blnk_api_key_here
BLNK_BASE_URL=https://api.blnk.finance

# Stripe API Configuration (test mode key)
STRIPE_SECRET_KEY=sk_test_your_key_here

# Demo Configuration
DEMO_CURRENCY=usd
DEMO_DEPOSIT_COUNT=10
DEMO_IDENTITY_FIRST_NAME=Pouch
DEMO_IDENTITY_LAST_NAME=Customer

# Optional: comma-separated mismatch scenarios
# Supported values: missing_ledger,wrong_reference,wrong_amount
DEMO_MISMATCH_SCENARIOS=missing_ledger,wrong_amount

# Optional: default output directory
DEMO_OUTPUT_DIR=./output
